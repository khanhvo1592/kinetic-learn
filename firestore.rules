rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Default rule for the new project: Allow any logged-in user to read/write.
    // In production, you would restrict this to only Admins for specific collections.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
